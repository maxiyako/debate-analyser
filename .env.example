# GCP / Vertex AI (required for the agent pipeline)
# Auth: gcloud auth application-default login --project=<your-project-id>
GCP_PROJECT_ID=
GCP_LOCATION=europe-west1
# Optional: service-account key file (Cloud Run job / CI). Empty = use ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini model (Vertex)
GEMINI_MODEL=gemini-2.5-pro

# Fact pipeline: top-N claims (by salience) forwarded to fact-checkers
MAX_CLAIMS=20

# Hugging Face (accept pyannote model terms first)
HUGGINGFACE_TOKEN=
# Fail fast if diarization can't run (no token) instead of collapsing to 1 speaker
REQUIRE_DIARIZATION=false

# Fact-checking uses Vertex Gemini grounding (GCP) + verified Slovak sources via
# DuckDuckGo (ddgs) and the ŠÚSR DATAcube API. No extra API keys needed.

# Optional GCS
USE_GCS=false
GCS_BUCKET=

# Local ML
# Device: cuda | cpu | mps
WHISPER_DEVICE=cpu
WHISPER_MODEL_ID=kinit/whisper-large-v3-sk
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-3.1

# Optional CrewAI tracing
CREWAI_TRACING_ENABLED=false
